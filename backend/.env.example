HTTP_BIND=0.0.0.0:8080
DATABASE_URL=sqlite://data/indexer.db
SOLANA_GRPC_ENDPOINT=https://your-yellowstone-provider.example
SOLANA_GRPC_X_TOKEN=
SOLANA_RPC_HTTP_URL=
SOLANA_EXPLORER_BASE_URL=https://explorer.solana.com
SOLANA_EXPLORER_CLUSTER=mainnet-beta
TELEGRAM_BOT_TOKEN=
TELEGRAM_API_BASE=https://api.telegram.org
# Telegram chat commands are enabled automatically when TELEGRAM_BOT_TOKEN is set.
# Optional. When set, every /api/* request must include x-firewatch-origin-token
# with this value. Keep /healthz public for load balancer and Dokploy checks.
ORIGIN_API_TOKEN=
CORS_ALLOWED_ORIGIN=http://127.0.0.1:5173
DELIVERY_POLL_SECONDS=5
RECONNECT_DELAY_SECONDS=5
SNS_REFRESH_SECONDS=300
CRITICAL_SOL_DOMAINS=ferno.sol
FERNO_BLOCK_BASE_URL=https://block.ferno.ag/block
