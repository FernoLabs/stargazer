HTTP_BIND=127.0.0.1:8080
DATABASE_URL=sqlite:///var/lib/firewatch/indexer.db
BLOB_STORE_DIR=/var/lib/firewatch/blobs

# Optional live S3/R2 blob storage. When BLOB_STORE_S3_BUCKET is set, generated
# program bytes, IDLs, and disassemblies are written to S3/R2 immediately.
# If this is empty, the backend can also use R2_BLOB_BUCKET/R2_BLOB_PREFIX.
BLOB_STORE_S3_BUCKET=
BLOB_STORE_S3_PREFIX=blobs
BLOB_STORE_S3_ENDPOINT_URL=
BLOB_STORE_S3_REGION=auto
BLOB_STORE_S3_ACCESS_KEY_ID=
BLOB_STORE_S3_SECRET_ACCESS_KEY=

SOLANA_GRPC_ENDPOINT=https://your-yellowstone-provider.example
SOLANA_GRPC_X_TOKEN=
SOLANA_RPC_HTTP_URL=
SOLANA_EXPLORER_BASE_URL=https://explorer.solana.com
SOLANA_EXPLORER_CLUSTER=mainnet-beta

TELEGRAM_BOT_TOKEN=
TELEGRAM_API_BASE=https://api.telegram.org
FIREWATCH_WEB_BASE_URL=https://watch.ferno.ag
ORIGIN_API_TOKEN=

# The Cloudflare frontend normally uses the same-origin /api/backend proxy, so
# CORS is only needed for direct browser access to the origin.
CORS_ALLOWED_ORIGIN=https://watch.ferno.ag

DELIVERY_POLL_SECONDS=5
RECONNECT_DELAY_SECONDS=5
SNS_REFRESH_SECONDS=300
CRITICAL_SOL_DOMAINS=ferno.sol
FERNO_BLOCK_BASE_URL=https://block.ferno.ag/block
