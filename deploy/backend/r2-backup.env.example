DB_PATH=/var/lib/firewatch/indexer.db
BACKUP_TMP_DIR=/var/tmp/firewatch-backups

R2_ACCOUNT_ID=your-cloudflare-account-id
R2_BUCKET=firewatch-backups
R2_PREFIX=sqlite-backups
# Optional override. Defaults to https://${R2_ACCOUNT_ID}.r2.cloudflarestorage.com
R2_ENDPOINT_URL=

AWS_ACCESS_KEY_ID=your-r2-access-key-id
AWS_SECRET_ACCESS_KEY=your-r2-secret-access-key
AWS_DEFAULT_REGION=auto
