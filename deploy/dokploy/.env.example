RUST_VERSION=1.95.0
FIREWATCH_BACKEND_IMAGE=firewatch-backend:local
FIREWATCH_BACKUP_IMAGE=firewatch-sqlite-r2-backup:local
CLOUDFLARED_IMAGE=cloudflare/cloudflared:latest

# Set to "tunnel" in Dokploy once CLOUDFLARE_TUNNEL_TOKEN is filled.
COMPOSE_PROFILES=

SOLANA_GRPC_ENDPOINT=https://your-yellowstone-provider.example
SOLANA_GRPC_X_TOKEN=
SOLANA_RPC_HTTP_URL=
SOLANA_PAY_RPC_HTTP_URL=https://jenifer-6iwpyb-fast-mainnet.helius-rpc.com
BLOB_STORE_DIR=/blobs

# Optional live S3/R2 blob storage. If left empty, the backend falls back to
# R2_BLOB_BUCKET/R2_BLOB_PREFIX below when those are set.
BLOB_STORE_S3_BUCKET=
BLOB_STORE_S3_PREFIX=blobs
BLOB_STORE_S3_ENDPOINT_URL=
BLOB_STORE_S3_REGION=auto
BLOB_STORE_S3_ACCESS_KEY_ID=
BLOB_STORE_S3_SECRET_ACCESS_KEY=

SOLANA_EXPLORER_BASE_URL=https://explorer.solana.com
SOLANA_EXPLORER_CLUSTER=mainnet-beta
SOLANA_PAY_CUSTOM_PLAN_AMOUNT=
SOLANA_PAY_CUSTOM_PLAN_MONTHLY_AMOUNT=5
SOLANA_PAY_CUSTOM_PLAN_YEARLY_AMOUNT=50
SOLANA_PAY_AMOUNT=
SOLANA_PAY_RECIPIENT=49mmYSJPUMgu2AcV7u3U3vQ3vean6PbDzV9pw1RmQeQh
SOLANA_PAY_SPL_TOKEN=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v

TELEGRAM_BOT_TOKEN=
TELEGRAM_API_BASE=https://api.telegram.org
FIREWATCH_WEB_BASE_URL=https://watch.ferno.ag
ORIGIN_API_TOKEN=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# The Cloudflare frontend normally uses /api/backend, so direct CORS is only
# needed for ad hoc browser access to the origin.
CORS_ALLOWED_ORIGIN=https://watch.ferno.ag

# Optional Cloudflare Tunnel sidecar. Keep the backend service private and let
# Cloudflare reach it through firewatch-cloudflared.
CLOUDFLARE_TUNNEL_ID=24bab5c9-01d6-4448-a35e-94280db763db
CLOUDFLARE_TUNNEL_HOSTNAME=firewatch-origin.ferno.ag
CLOUDFLARE_TUNNEL_TOKEN=

DELIVERY_POLL_SECONDS=5
TELEGRAM_DAILY_SUMMARY_POLL_SECONDS=300
TELEGRAM_DAILY_SUMMARY_HOUR_UTC=9
RECONNECT_DELAY_SECONDS=5
SNS_BOOTSTRAP_LABEL_LIMIT=96
LIQUIDITY_POOL_SNAPSHOT_RETENTION_DAYS=3
WATCHED_LIQUIDITY_POOL_SNAPSHOT_RETENTION_DAYS=7
LIQUIDITY_POOL_SNAPSHOT_PRUNE_INTERVAL_SECONDS=21600
CRITICAL_SOL_DOMAINS=ferno.sol
FERNO_BLOCK_BASE_URL=https://block.ferno.ag/block

# Optional R2 backup service. These are only needed when running the
# firewatch-r2-backup compose profile or a Dokploy schedule for it.
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_BUCKET=firewatch-backups
R2_PREFIX=sqlite-backups
R2_BLOB_BUCKET=firewatch-blobs
R2_BLOB_PREFIX=blobs
R2_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=your-r2-access-key-id
AWS_SECRET_ACCESS_KEY=your-r2-secret-access-key
AWS_DEFAULT_REGION=auto
