# Private origin URL used by SvelteKit server loads and the Cloudflare proxy route.
# BACKEND_BASE_URL is still supported as a legacy alias.
BACKEND_ORIGIN_URL=http://127.0.0.1:8080
# Must match backend ORIGIN_API_TOKEN when that backend setting is enabled.
BACKEND_ORIGIN_TOKEN=

# Required to open /admin and protected proxy paths. Use a real secret outside local dev.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Public base returned to the browser. In production this should usually stay
# same-origin so Cloudflare can cache and protect the Hetzner backend.
PUBLIC_BACKEND_BASE_URL=/api/backend

PUBLIC_SOLANA_EXPLORER_CLUSTER=mainnet-beta
