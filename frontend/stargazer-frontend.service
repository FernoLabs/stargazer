[Unit]
Description=Stargazer NAS demo frontend
After=network-online.target stargazer-read-api.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/stargazer/frontend
ExecStart=/usr/bin/node ./node_modules/vite/bin/vite.js dev --host 127.0.0.1 --port 5173
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
UMask=0022

[Install]
WantedBy=default.target
