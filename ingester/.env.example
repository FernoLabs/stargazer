STELLAR_NETWORK=public
STELLAR_NETWORK_PASSPHRASE=Public Global Stellar Network ; September 2015

# rpc, captive_core, or data_lake
STELLAR_LEDGER_SOURCE=rpc

# Public, rate-limited POC endpoints. Use authenticated URLs in production.
STELLAR_RPC_URL=https://rpc.mainnet.stellar.gateway.fm
STELLAR_RPC_FALLBACK_URLS=https://rpc.ankr.com/stellar_soroban,https://rpc.lightsail.network/
STELLAR_ARCHIVE_RPC_URL=https://rpc.ankr.com/stellar_soroban
STELLAR_ARCHIVE_RPC_FALLBACK_URLS=https://archive-rpc.lightsail.network/,https://stellar.api.onfinality.io/public

STELLAR_CAPTIVE_CORE_BINARY=stellar-core
STELLAR_DATA_LAKE_URI=s3://aws-public-blockchain/v1.1/stellar/ledgers/pubnet
STELLAR_DATA_LAKE_REGION=us-east-2

# Empty means resume from the application database checkpoint.
STELLAR_START_LEDGER=
STELLAR_END_LEDGER=

STELLAR_WATCH_INGEST_URL=http://127.0.0.1:8080/internal/stellar/ledgers
STELLAR_WATCH_INGEST_TOKEN=
STELLAR_WATCH_REQUEST_TIMEOUT_SECONDS=30
STELLAR_WATCH_RETRY_SECONDS=5

# Dedicated Telegram alert-control service. Never reuse a ledger-index DB.
STARGAZER_ALERT_CONTROL_DB=./data/stargazer-alert-control.sqlite
STARGAZER_ALERT_CONTROL_HOST=127.0.0.1
STARGAZER_ALERT_CONTROL_PORT=8788
# Prefer server-side frontend actions. Add exact browser origins only if needed.
STARGAZER_ALERT_CONTROL_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Bot username without @. Keep the BotFather token in a secret manager.
STARGAZER_TELEGRAM_BOT_USERNAME=
STARGAZER_TELEGRAM_BOT_TOKEN=
STARGAZER_TELEGRAM_API_BASE=https://api.telegram.org
STARGAZER_PUBLIC_APP_URL=http://127.0.0.1:5173/app

# Fail-closed default: no payment is collected and no entitlement is created.
# The only other implemented value is "pilot", which grants a bounded operator
# pilot and must be an explicit deployment choice. There is no paid mode yet.
STARGAZER_ALERT_BILLING_MODE=unconfigured
STARGAZER_ALERT_PILOT_DAYS=30
