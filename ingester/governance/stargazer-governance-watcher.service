[Unit]
Description=Stargazer Stellar controller watcher
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/volume1/stargazer/stargazer/governance
ExecStart=/volume1/stargazer/stargazer/runtime/node-v22.23.1-linux-x64/bin/node /volume1/stargazer/stargazer/governance/watcher.mjs --output-dir /volume1/stargazer/stargazer/governance/state
Restart=on-failure
RestartSec=10
NoNewPrivileges=true
UMask=0077

[Install]
WantedBy=default.target
