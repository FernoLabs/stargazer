[Unit]
Description=Stargazer Stellar controller watcher
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/stargazer/ingester/governance
ExecStart=/usr/bin/node /opt/stargazer/ingester/governance/watcher.mjs --output-dir /var/lib/stargazer/governance/state
Restart=on-failure
RestartSec=10
NoNewPrivileges=true
UMask=0077

[Install]
WantedBy=default.target
