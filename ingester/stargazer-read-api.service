[Unit]
Description=Stargazer read API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/stargazer-read-api --db /var/lib/stargazer/index/stargazer-one-year-compact.sqlite --serving-db /var/lib/stargazer/index/stargazer-serving.sqlite --governance-dir /var/lib/stargazer/governance/state --host 127.0.0.1 --port 8787 --query-timeout-ms 30000 --cors-origin https://stargazer.example
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
UMask=0077

[Install]
WantedBy=default.target
